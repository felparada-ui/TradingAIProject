# =============================================================================
# TRADING AI PROJECT — VARIABLES DE ENTORNO
# =============================================================================
# Copia este archivo a .env y completa los valores:
#   cp .env.example .env
# =============================================================================

# --- OpenAI / LLM (obligatorio para modo llm) ---
# OPENAI_API_KEY=sk-your-key
# OPENAI_API_BASE=https://api.openai.com/v1

# --- Telegram (recomendado) ---
# TELEGRAM_BOT_TOKEN=your_bot_token
# TELEGRAM_CHAT_ID=your_chat_id

# --- MetaTrader 5 — Cuenta Demo (obligatorio para modo live) ---
# MT5_LOGIN=12345678
# MT5_PASSWORD=your_password
# MT5_SERVER=ICMarketsSC-Demo

# --- NewsAPI (opcional — sentimiento real) ---
# NEWSAPI_KEY=your_newsapi_key
